    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Get original customer data from Webhook\nconst webhookData = $('Webhook').first().json;\nconst booking = webhookData.body ?? webhookData;\n\n// Get service returned by Google Sheets\nconst serviceRows = $input.all().map(item => item.json);\n\nconst requestedCode = String(\n  booking.service_code ?? ''\n).trim().toLowerCase();\n\nconst service = serviceRows.find(row =>\n  String(row.service_code ?? '').trim().toLowerCase() === requestedCode\n) ?? {};\n\nconst errors = [];\n\nconst name = String(booking.customer_name ?? '').trim();\nconst email = String(booking.email ?? '').trim().toLowerCase();\nconst phone = String(booking.phone ?? '').trim();\nconst serviceCode = String(booking.service_code ?? '').trim().toLowerCase();\nconst date = String(booking.date ?? '').trim();\nconst time = String(booking.time ?? '').trim();\nconst notes = String(booking.notes ?? '').trim();\n\nconst duration = Number(service.duration_minutes);\n\nif (!name) errors.push('Customer name is required');\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  errors.push('Invalid email address');\n}\n\nif (!/^\\+?[0-9][0-9\\s()-]{6,18}$/.test(phone)) {\n  errors.push('Invalid phone number');\n}\n\nif (!service.service_code || \n    String(service.service_code).trim().toLowerCase() !== serviceCode) {\n  errors.push('Selected service does not exist');\n}\n\nconst active = String(service.active ?? '').trim().toLowerCase();\n\nif (!['true', '1', 'yes'].includes(active)) {\n  errors.push('Selected service is unavailable');\n}\n\nif (!Number.isFinite(duration) || duration <= 0) {\n  errors.push('Invalid service duration');\n}\n\n// Validate date and time\nconst dateValid =\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(date) &&\n  !Number.isNaN(Date.parse(`${date}T12:00:00Z`)) &&\n  new Date(`${date}T12:00:00Z`).toISOString().slice(0, 10) === date;\n\nconst timeValid = /^(?:[01]\\d|2[0-3]):(?:00|30)$/.test(time);\n\nif (!dateValid) errors.push('Date must use YYYY-MM-DD format');\nif (!timeValid) errors.push('Time must use HH:mm format');\n\nlet startMs = NaN;\nlet endMs = NaN;\n\nif (dateValid && timeValid && Number.isFinite(duration)) {\n  startMs = new Date(`${date}T${time}:00+05:00`).getTime();\n  endMs = startMs + duration * 60000;\n\n  const todayAstana = new Date(Date.now() + 5 * 60 * 60 * 1000)\n    .toISOString().slice(0, 10);\n\n  if (date < todayAstana || startMs <= Date.now()) {\n    errors.push('Appointment must be in the future');\n  }\n\n  // Sunday is closed\n  const dayOfWeek = new Date(`${date}T12:00:00Z`).getUTCDay();\n\n  if (dayOfWeek === 0) {\n    errors.push('The studio is closed on Sundays');\n  }\n\n  // Business hours: 10:00–20:00\n  const localEnd = new Date(endMs + 5 * 60 * 60 * 1000);\n  const startMinutes = Number(time.slice(0, 2)) * 60 +\n                       Number(time.slice(3, 5));\n  const endMinutes = localEnd.getUTCHours() * 60 +\n                     localEnd.getUTCMinutes();\n\n  const endLocalDate = localEnd.toISOString().slice(0, 10);\n\n  if (startMinutes < 600 || endMinutes > 1200 ||\n      endLocalDate !== date) {\n    errors.push('Appointment must fit within 10:00–20:00');\n  }\n}\n\nif (notes.length > 500) {\n  errors.push('Notes must not exceed 500 characters');\n}\n\nconst isValid = errors.length === 0;\n\nreturn [{\n  json: {\n    customer_name: name,\n    email,\n    phone,\n    service_code: serviceCode,\n    service: service.service_name || '',\n    duration_minutes: duration,\n    date,\n    time,\n    timezone: 'Asia/Almaty',\n    start_at: Number.isFinite(startMs)\n      ? new Date(startMs).toISOString()\n      : '',\n    end_at: Number.isFinite(endMs)\n      ? new Date(endMs).toISOString()\n      : '',\n    notes,\n    booking_id: crypto.randomUUID(),\n    management_token: crypto.randomBytes(32).toString('hex'),\n    status: 'confirmed',\n    created_at: new Date().toISOString(),\n    updated_at: new Date().toISOString(),\n    reminder_24h_sent: 'FALSE',\n    reminder_1h_sent: 'FALSE',\n    is_valid: isValid,\n    validation_error: errors.join('; ')\n  }\n}];\n\n"
      },
